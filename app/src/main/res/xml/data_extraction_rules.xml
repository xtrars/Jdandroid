<?xml version="1.0" encoding="utf-8"?>
<!--
  Ab Android 12: Konten (auch verschluesselt), Download-Liste und
  Einstellungen gehoeren weder in Cloud-Backups noch in den Geraetewechsel.
  Der Keystore-Schluessel wandert ohnehin nicht mit; die Daten waeren
  nach einer Wiederherstellung unbrauchbar.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
